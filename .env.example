# OpenRouter key used for every model call (embeddings, reranking, answers, judge).
OPENROUTER_API_KEY=

# Models. The chat model is the generator of the initial active configuration.
JUDGE_MODEL=deepseek/deepseek-v4.1-flash-1017
CHAT_MODEL=ibm-granite/granite-4.2-8b
# Synthetic data (draft questions, the mock external service) uses the cheapest model only.
SEED_MODEL=meta-llama/llama-3.1-8b-instruct

# Demo accounts created on first start. Change them outside a local demo.
ADMIN_EMAIL=admin@ragdoctor.demo
ADMIN_PASSWORD=doctor-admin
USER_EMAIL=reader@ragdoctor.demo
USER_PASSWORD=doctor-reader
# Signs the session cookie. Any long random string.
JWT_SECRET=change-me-in-production
# Set to true to require a login for the chat as well as for the admin area.
CHAT_REQUIRES_LOGIN=false

# Host ports.
WEB_PORT=5310
API_PORT=8310
DB_PORT=54330
MOCK_RAG_PORT=8311

# Private key that can read the rag-bench repository while it is private (build time only).
RAGBENCH_SSH_KEY=~/.ssh/id_ed25519
